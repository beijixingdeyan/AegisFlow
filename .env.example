# ============================================================================
# AegisFlow — environment template (DUMMY values only — never commit real secrets)
# Copy to .env and fill in real values. .env is git-ignored.
# ============================================================================

# Mode: onprem | hybrid | saas  (switches deployment/telemetry/config decoupling)
AEGISFLOW_MODE=onprem

# Listener for the Management Plane REST API
AEGISFLOW_API_HOST=0.0.0.0
AEGISFLOW_API_PORT=8080

# Data plane ingestion port (event/message bus)
AEGISFLOW_INGEST_PORT=9090

# Zero-trust mTLS: paths to node identity + CA bundle.
# VALUES BELOW ARE PLACEHOLDERS — generate real certs at deploy time.
AEGISFLOW_TLS_CERT_PATH=deploy/dev-certs/node.crt
AEGISFLOW_TLS_KEY_PATH=deploy/dev-certs/node.key
AEGISFLOW_TLS_CA_PATH=deploy/dev-certs/ca.crt

# External KMS provider: vault | aws | aliyun | local (local = demo only)
AEGISFLOW_KMS_PROVIDER=local
AEGISFLOW_KMS_ENDPOINT=

# Data-at-rest master key reference (managed by the KMS; never a literal key)
AEGISFLOW_DATA_KEY_REF=aeegisflow/master-data-key

# Audit hash-chain state directory
AEGISFLOW_AUDIT_DIR=data/audit

# Autonomous response policy: observe | suggest | approve | auto
AEGISFLOW_RESPONSE_MODE=approve

# LLM reasoning provider: mock | http (mock ships a heuristic scorer so demos/tests
# run offline without any LLM API key)
AEGISFLOW_LLM_PROVIDER=mock
AEGISFLOW_LLM_ENDPOINT=
AEGISFLOW_LLM_API_KEY=

# Logging
AEGISFLOW_LOG_LEVEL=INFO
